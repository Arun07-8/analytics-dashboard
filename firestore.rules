rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if the user is accessing their own data
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Sales Collection Rules
    match /sales/{saleId} {
      allow read: if isAuthenticated() && isOwner(resource.data.createdBy);
      
      // Strict rule: Staff can only edit or delete if the sale request is still pending. 
      // (Admins bypassing this via Admin SDK will not be affected by client rules)
      allow update, delete: if isAuthenticated() && isOwner(resource.data.createdBy) && resource.data.verificationStatus == 'Pending';
      
      // Allow create if the new document's creator matches the requesting user's UID
      allow create: if isAuthenticated() && isOwner(request.resource.data.createdBy);
    }

    // Default deny for other collections (add more specific rules as needed)
    match /{document=**} {
      allow read, write: if false; // Strict default, modify as needed for other collections
    }
  }
}
