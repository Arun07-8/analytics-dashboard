rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if the user is an admin
    // We use getExists() or catch exceptions safely
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper to check if the user is accessing their own data
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper to check if the user is an admin
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    // Sales Collection Rules
    match /sales/{saleId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.createdBy) || isAdmin());
      
      // Staff can only edit or delete if the sale request is still pending. 
      // Admins can edit or delete any sale record.
      allow update, delete: if isAuthenticated() && (
        (isOwner(resource.data.createdBy) && resource.data.verificationStatus == 'Pending') || 
        isAdmin()
      );
      
      // Allow create if the new document's creator matches the requesting user's UID
      allow create: if isAuthenticated() && isOwner(request.resource.data.createdBy);
    }

    // Default deny for other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
