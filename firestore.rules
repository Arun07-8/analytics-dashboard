rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if the user is accessing their own data
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Sales Collection Rules
    match /sales/{saleId} {
      // Allow read/update/delete if the document's staffId matches the requesting user's UID
      allow read, update, delete: if isAuthenticated() && isOwner(resource.data.staffId);
      
      // Allow create if the new document's staffId matches the requesting user's UID
      allow create: if isAuthenticated() && isOwner(request.resource.data.staffId);
    }

    // Default deny for other collections (add more specific rules as needed)
    match /{document=**} {
      allow read, write: if false; // Strict default, modify as needed for other collections
    }
  }
}
